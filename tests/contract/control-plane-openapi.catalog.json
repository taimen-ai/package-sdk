   "AgentPlacementSpec": {
    "additionalProperties": false,
    "description": "Where the agent may run. The core stores it; the placement service reads it.",
    "properties": {
     "drainSeconds": {
      "default": 14400,
      "maximum": 14400.0,
      "minimum": 0.0,
      "title": "Drainseconds",
      "type": "integer"
     },
     "replicas": {
      "default": 1,
      "description": "Desired state, not revision",
      "maximum": 20.0,
      "minimum": 0.0,
      "title": "Replicas",
      "type": "integer"
     },
     "requires": {
      "description": "Labels a node must carry: name or name=value",
      "items": {
       "maxLength": 100,
       "pattern": "^[a-z0-9][a-z0-9.-]*(=[a-zA-Z0-9._-]+)?$",
       "type": "string"
      },
      "maxItems": 200,
      "title": "Requires",
      "type": "array"
     },
     "resources": {
