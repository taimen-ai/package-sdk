{
 "components": {
  "schemas": {
   "AcceptanceCheckSpec": {
    "additionalProperties": false,
    "description": "One declared check, executed by the verification stage (CP-ADR-0067).\n\nOn a task, ``spec`` follows the grammar of ``kind``: ``deterministic`` —\n``{skill: name@version, inputs?, expect?}`` or ``{artifact: {type,\nmediaTypes?, content?}}``; ``external_state`` —\n``{event?}``; ``human`` — ``{approver? | approverRole?}``; ``llm_judge`` —\nas ``human`` plus ``rubric?``. A spec outside it is\n``422 invalid_acceptance_spec``. On a goal it is not interpreted.\n\n``when`` — ``$.task`` expressions (CP-ADR-0061 grammar) that must all\nresolve to something when the attempt reaches the check; otherwise the\ncheck is ``skipped`` with reason ``condition_unmet``. Not on a goal.",
    "properties": {
     "description": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Description",
      "type": "string"
     },
     "key": {
      "maxLength": 63,
      "minLength": 1,
      "title": "Key",
      "type": "string"
     },
     "kind": {
      "enum": [
       "deterministic",
       "external_state",
       "human",
       "llm_judge"
      ],
      "title": "Kind",
      "type": "string"
     },
     "spec": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Spec"
     },
     "when": {
      "anyOf": [
       {
        "items": {
         "maxLength": 500,
         "minLength": 1,
         "type": "string"
        },
        "maxItems": 8,
        "minItems": 1,
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "When"
     }
    },
    "required": [
     "key",
     "kind",
     "description"
    ],
    "title": "AcceptanceCheckSpec",
    "type": "object"
   },
   "AgentExecutorSpec": {
    "additionalProperties": false,
    "description": "How the agent executes. ``kind`` is a string, never a vendor enum (art. II).",
    "properties": {
     "instructions": {
      "default": "",
      "maxLength": 65536,
      "title": "Instructions",
      "type": "string"
     },
     "kind": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$",
      "title": "Kind",
      "type": "string"
     },
     "params": {
      "additionalProperties": true,
      "description": "Parameters of the executor kind; checked by its schema, not by the core",
      "title": "Params",
      "type": "object"
     }
    },
    "required": [
     "kind"
    ],
    "title": "AgentExecutorSpec",
    "type": "object"
   },
   "AgentIamSpec": {
    "additionalProperties": false,
    "description": "The IAM part of the identity: data for whoever issues the account, not the core.",
    "properties": {
     "audiences": {
      "items": {
       "maxLength": 100,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Audiences",
      "type": "array"
     },
     "scopeCeiling": {
      "items": {
       "maxLength": 200,
       "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$",
       "type": "string"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Scopeceiling",
      "type": "array"
     }
    },
    "required": [
     "audiences",
     "scopeCeiling"
    ],
    "title": "AgentIamSpec",
    "type": "object"
   },
   "AgentIdentitySpec": {
    "additionalProperties": false,
    "description": "Who the agent is: the core derives its principal and binding from this.",
    "properties": {
     "capabilities": {
      "items": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 200,
      "title": "Capabilities",
      "type": "array"
     },
     "iam": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/AgentIamSpec"
       },
       {
        "type": "null"
       }
      ],
