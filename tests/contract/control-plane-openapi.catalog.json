   "AgentSkillsSpec": {
    "additionalProperties": false,
    "description": "Which skills the agent executes itself (CP-ADR-0056) and where they may go.\n\n``invoke`` is the other direction: skill versions the agent calls through\n``POST /skills/{ref}:invoke`` rather than hosts (amendment 2026-09-28).",
    "properties": {
     "audiences": {
      "description": "IAM audiences the skills get a token for",
      "items": {
       "maxLength": 100,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 200,
      "title": "Audiences",
      "type": "array"
     },
     "concurrency": {
      "anyOf": [
       {
        "maximum": 32.0,
        "minimum": 1.0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Concurrency"
     },
     "httpOrigins": {
      "items": {
       "maxLength": 500,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 200,
      "title": "Httporigins",
      "type": "array"
     },
     "invoke": {
      "description": "Skill versions the agent calls through the core (name@version); the registry assigns them to its principal",
      "items": {
       "maxLength": 251,
       "pattern": "^[^@\\s/]{1,200}@[^@\\s/]{1,50}$",
       "type": "string"
      },
      "maxItems": 200,
      "title": "Invoke",
      "type": "array"
     },
     "local": {
      "description": "Allowed entry points or packages",
      "items": {
       "pattern": "^[A-Za-z_][\\w.]*(:[A-Za-z_]\\w*)?$",
       "type": "string"
      },
      "maxItems": 200,
      "title": "Local",
      "type": "array"
     },
     "mcpOrigins": {
      "items": {
       "maxLength": 500,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 200,
      "title": "Mcporigins",
      "type": "array"
     },
     "protocols": {
      "items": {
       "enum": [
        "local",
        "http",
        "mcp"
       ],
       "type": "string"
      },
      "title": "Protocols",
      "type": "array"
     }
    },
    "title": "AgentSkillsSpec",
    "type": "object"
   },
