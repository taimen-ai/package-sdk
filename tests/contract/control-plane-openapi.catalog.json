     },
     "kind": {
      "enum": [
       "agent",
       "service"
      ],
      "title": "Kind",
      "type": "string"
     },
     "permissions": {
      "items": {
       "pattern": "^[a-z_]+(\\.[a-z_]+)+$",
       "type": "string"
      },
      "maxItems": 200,
      "minItems": 1,
