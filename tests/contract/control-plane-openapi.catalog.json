      ],
      "title": "Workspaceid"
     }
    },
    "required": [
     "id",
     "tenantId",
     "key",
     "displayName",
     "status",
     "state",
     "replicas",
     "currentRevision",
     "revision",
     "principalId",
     "workspaceId",
     "retiredAt",
     "retiredBy",
