# The skills host of the package claims: the runner image of the platform in the skills
# mode with the integration of the package. Generated by:
#   package-sdk image skills --package . --modules claims_helpdesk.skills
# Build from the package directory: docker build --build-arg RUNNER_IMAGE=<image> -f Dockerfile.skills .
ARG RUNNER_IMAGE
FROM ${RUNNER_IMAGE}
# The Python of the executor's environment in the runner image
ARG RUNNER_PYTHON=python
USER root
RUN "$RUNNER_PYTHON" -c "import skill_sdk, control_plane_client" \
    || (echo "the runner image has no skill-sdk and core client" >&2; exit 1)
RUN "$RUNNER_PYTHON" -c "from importlib.metadata import version as v; \
print('skill-sdk==' + v('skill-sdk')); \
print('control-plane-client==' + v('control-plane-client'))" > /tmp/platform-constraints.txt
COPY integration/pyproject.toml /opt/package/integration/pyproject.toml
COPY integration/src /opt/package/integration/src
RUN uv pip install --python "$RUNNER_PYTHON" --constraint /tmp/platform-constraints.txt \
    /opt/package/integration
ENV RUNNER_MODE=skills CONTROL_PLANE_SKILLS_LOCAL_PACKAGES="claims_helpdesk.skills"
USER 10001
